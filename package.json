{
  "name": "notch",
  "private": true,
  "version": "0.1.0",
  "description": "Always-on-top desktop notch — weather, Spotify, and settings",
  "repository": {
    "type": "git",
    "url": "https://github.com/yassenshopov/notch.git"
  },
  "author": "Yassen Shopov",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 nodemon --quiet --watch electron --ext cjs,js --exec electron .\"",
    "dev:web": "vite",
    "dev:electron": "cross-env ELECTRON_DEV=1 electron .",
    "build": "tsc -b && vite build",
    "start": "npm run build && cross-env NOTCH_FORCE_DIST=1 electron .",
    "start:dev": "npm run build && electron .",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify:expand": "npm run build && cross-env NOTCH_VERIFY_EXPAND=1 electron .",
    "verify:neon": "node scripts/verify-neon.mjs",
    "sync:strava-neon": "electron scripts/sync-strava-neon.cjs",
    "sync:github-neon": "electron scripts/sync-github-neon.cjs",
    "sync:all-neon": "electron scripts/sync-all-neon.cjs",
    "sync:spotify-neon": "electron scripts/sync-spotify-neon.cjs",
    "register:spotify-backfill-task": "powershell -ExecutionPolicy Bypass -File scripts/register-spotify-listen-backfill-task.ps1",
    "import:spotify-history": "node scripts/import-spotify-extended.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.yassenshopov.notch",
    "productName": "Notch",
    "copyright": "Copyright © Yassen Shopov",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/**/*.map"
    ],
    "asarUnpack": [
      "electron/native/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@iconify/react": "^6.0.2",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neondatabase/serverless": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^18.0.7",
    "koffi": "^3.3.6",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.5.1"
  }
}
