[Unit]
Description=Wi-Fi Sense Agent (managed RSSI)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=yassenshopov
WorkingDirectory=/home/yassenshopov/wifi-sense-agent
EnvironmentFile=-/home/yassenshopov/wifi-sense-agent/.env
ExecStart=/usr/bin/env PYTHONPATH=/home/yassenshopov/wifi-sense-agent /usr/bin/python3 -m agent.main
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
