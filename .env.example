SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:43110/callback

# Cursor — plan usage uses your IDE login; optional overrides below
# CURSOR_API_KEY=crsr_...                  # Cloud Agents API (recent agents in the Cursor panel)
# CURSOR_SESSION_TOKEN=sub_xxx::eyJ...     # browser cookie WorkosCursorSessionToken
# CURSOR_ACCESS_TOKEN=eyJ...               # JWT only; sub is parsed from the payload

# GitHub — notifications & PRs in the GitHub panel / island face
# GITHUB_TOKEN=ghp_...

# Strava — activities, maps & heatmaps (use your Strava API application)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://127.0.0.1:43111/callback
# Optional: seed OAuth tokens without browser connect
# STRAVA_REFRESH_TOKEN=
# STRAVA_ACCESS_TOKEN=
