SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:43110/callback

# Cursor — plan usage uses your IDE login; optional overrides below
# CURSOR_API_KEY=crsr_...                  # Cloud Agents API (recent agents in the Cursor panel)
# CURSOR_SESSION_TOKEN=sub_xxx::eyJ...     # browser cookie WorkosCursorSessionToken
# CURSOR_ACCESS_TOKEN=eyJ...               # JWT only; sub is parsed from the payload

# GitHub — notifications & PRs in the GitHub panel / island face
# GITHUB_TOKEN=ghp_...

# CARTO — minimal map tiles for Strava route/heatmap panels (https://carto.com/basemaps/apikey)
# Tile URLs use ?key=… — CARTO_API_KEY is read in Electron; optional VITE_CARTO_API_KEY for Vite-only dev
# CARTO_API_KEY=
# VITE_CARTO_API_KEY=

# Strava — activities, maps & heatmaps (use your Strava API application)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://127.0.0.1:43111/callback
# Optional: seed OAuth tokens without browser connect
# STRAVA_REFRESH_TOKEN=
# STRAVA_ACCESS_TOKEN=

# Home servers — SSH host aliases (see ~/.ssh/config); override defaults mint / pi
# NOTCH_MINT_SSH_HOST=mint
# NOTCH_PI_SSH_HOST=pi

# Wi-Fi Sense — Mint agent (managed RSSI; default URL from Mint Tailscale IP :8765 in Settings)
# WIFI_SENSE_AGENT_URL=http://100.x.x.x:8765
# WIFI_SENSE_TOKEN=
# Spotify device name substring(s) for Pi TV playback (comma-separated)
# NOTCH_PI_SPOTIFY_DEVICE=raspotify,raspberry

# Tailscale — disable key expiry on Pi + Mint (scripts/tailscale-disable-key-expiry.mjs)
# TAILSCALE_API_KEY=tskey-api-...
# TAILSCALE_TAILNET=yassenshopov00.github
# TAILSCALE_NO_EXPIRY_HOSTS=raspberrypi,yassenshopov-x540na

